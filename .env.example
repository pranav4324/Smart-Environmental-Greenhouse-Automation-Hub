# Backend Server Port
PORT=5000

# Google Gemini API Key (Primary AI Engine — free tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Legacy fallback — used only if Gemini key is not set)
OPENAI_API_KEY=your_openai_api_key_here

# Firebase Admin SDK Credentials (Optional: Server-only, fallback in-memory store if omitted)
FIREBASE_PROJECT_ID=smart-greenhouse-hub
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@smart-greenhouse-hub.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXX\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://smart-greenhouse-hub-default-rtdb.firebaseio.com

# MQTT Broker Settings for Physical ESP32 Hardware Integration
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TELEMETRY_TOPIC=greenhouse/telemetry
MQTT_COMMAND_TOPIC=greenhouse/commands
